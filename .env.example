# DermaDetect AI - Environment Configuration Example
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit your actual .env file or real secrets to Git/GitHub!

# Required: Google Gemini API Key for clinical analysis
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server Port (defaults to 3000)
PORT=3000

# Optional: Host URL for self-referencing and headers
APP_URL=http://localhost:3000

# Optional: Allowed CORS origins (comma-separated list for cross-origin hosting)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: OpenRouter API key for secondary-tier multi-model failover
OPENROUTER_API_KEY=your_openrouter_api_key_here
